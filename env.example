# ---------------------------------------------------------------------------
# LLM + EMBEDDINGS  (the only required section)
# ---------------------------------------------------------------------------
# One key, one provider, both endpoints. Get it at openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Swap models here and nowhere else. Any OpenRouter chat model works:
#   deepseek/deepseek-chat        (default, cheap, solid JSON)
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4o-mini
# Adjudicating a recurrence is a judgement call, and model choice shows up directly
# in the answer. Measured on the 3-transcript sample, 2026-09-12:
#   anthropic/claude-sonnet-5    2/2 runs grouped the thread correctly
#   deepseek/deepseek-chat-v3.1  1/2 runs (~$0.01/run vs ~$0.10 -- cheaper, less sure)
#   deepseek/deepseek-chat       2 provider endpoints only; both 429d together once
LLM_MODEL=anthropic/claude-sonnet-5
# 0 so a scripted demo reproduces run-to-run (reduces variance; providers
# still route non-deterministically, so it is not a determinism guarantee).
LLM_TEMPERATURE=0
LLM_JSON_MODE=true
# Keep OpenRouter off provider endpoints that do not implement response_format.
# Falls back automatically when no endpoint satisfies it, so a model swap cannot
# hard-fail on it.
# OPENROUTER_REQUIRE_PARAMETERS=true

# Embedding models are catalogued separately from chat models:
#   curl https://openrouter.ai/api/v1/embeddings/models
# The default is free. Note its 512-token limit, which EMBEDDING_MAX_CHARS guards.
# Changing this invalidates stored vectors -- see the note in README.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_MAX_CHARS=8000
# EMBEDDING_DIMENSIONS=1024      # 0/unset = the model's own default

# ---------------------------------------------------------------------------
# BEHAVIOUR
# ---------------------------------------------------------------------------
# Recurrence is TWO-STAGE: embeddings shortlist, the LLM decides.
# A single cosine threshold was measured against real embeddings and does not
# work -- the matching and non-matching score bands overlap, so no cutoff
# separates them. See CLAUDE.md. RECURRENCE_THRESHOLD is gone; this replaces it.
RECURRENCE_RECALL_THRESHOLD=0.15   # loose on purpose: recall only, precision is the LLM's job
                                   # measured: the weakest pair inside a genuine thread is
                                   # 0.177, so anything higher drops real links before the
                                   # LLM can see them. MAX_CANDIDATES bounds the cost.
RECURRENCE_MAX_CANDIDATES=8        # candidates per adjudication call, not calls per run
RECURRENCE_USE_LLM=true            # false = recall only (known not to separate)
RECURRENCE_CROSS_MEETING_ONLY=true # a recurrence means it came back in a LATER meeting
RECURRENCE_ESCALATE_COUNT=3        # occurrences before shouting in the channel
NUDGE_DAYS_BEFORE=2                # DM the owner this many days before due
ESCALATE_AFTER_DAYS=3              # post to the channel this long after overdue
RENUDGE_AFTER_HOURS=24             # don't re-nudge the same item inside this
DB_PATH=items.db

# These four are also settable at runtime with `/retroagent set <key> <value>`,
# which writes agent_config.json. That file takes precedence over this one.

# ---------------------------------------------------------------------------
# ADAPTERS -- toggle platforms on and off. Both forms are accepted:
#   ENABLED_TICKET_ADAPTERS=jira,clickup     or     ["jira","clickup"]
# ---------------------------------------------------------------------------
ENABLED_TICKET_ADAPTERS=jira,clickup
ENABLED_NOTIFIER_ADAPTERS=slack,teams

# unset = automatic: an adapter runs live if its credentials are present and
# dry-runs if they aren't, so you can bring platforms online one at a time.
# true  = never touch the network.  false = always call out.
# DRY_RUN=

# ---------------------------------------------------------------------------
# JIRA  (Cloud, REST v3). Token: id.atlassian.com/manage-profile/security/api-tokens
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task
# Map our statuses to YOUR workflow's transition names, or transitions silently
# won't be found (the adapter logs which ones were available).
# JIRA_STATUS_MAP={"pending":"To Do","in_progress":"In Progress","blocked":"Blocked","done":"Done"}

# ---------------------------------------------------------------------------
# CLICKUP  (API v2). Token: ClickUp -> Settings -> Apps -> API Token
# ---------------------------------------------------------------------------
CLICKUP_API_TOKEN=pk_...
# The list to file tasks in -- the number in the list's URL.
CLICKUP_LIST_ID=
# CLICKUP_STATUS_MAP={"pending":"to do","in_progress":"in progress","blocked":"blocked","done":"complete"}

# ---------------------------------------------------------------------------
# SLACK  (api.slack.com/apps -- see the setup notes in slack_listener.py)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...            # Socket Mode; only the listener needs it
SLACK_SIGNING_SECRET=
SLACK_TEAM_CHANNEL=#eng-retro
# Transcripts name people as "Dana"; DMs need a member ID. Map them:
# SLACK_USER_MAP={"dana":"U01ABCDEF","sam":"U02GHIJKL","priya":"U03MNOPQR"}

# ---------------------------------------------------------------------------
# TEAMS  (Power Automate Workflows webhook)
# NB: the classic Office 365 connector webhooks were retired 18-22 May 2026 and
# no longer deliver. Create a Workflows webhook instead:
#   channel ... -> Workflows -> "Post to a channel when a webhook request is received"
# ---------------------------------------------------------------------------
TEAMS_CHANNEL_WEBHOOK_URL=
TEAMS_DM_WEBHOOK_URL=               # a second flow using "Post to a chat"
TEAMS_TEAM_CHANNEL=Engineering / Retro
# TEAMS_USER_MAP={"dana":"dana@example.com","sam":"sam@example.com"}
